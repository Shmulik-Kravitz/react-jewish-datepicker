{
  "compilerOptions": {
    "types": [
      "node",
      "@testing-library/jest-dom",
      "@types/react-syntax-highlighter"
    ],
    "declaration": true,
    "emitDeclarationOnly": true,
    "module": "ESNext",
    "target": "ESNext",
    "sourceMap": true,
    "skipLibCheck": true,
    "jsx": "react",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "allowJs": true
  },
  "include": [
    "./src/**/*",
    "./app/**/*",
    "./__test__/**/*"
  ],
  "exclude": [
    "./node_modules/**/*",
    "./dist/**/*",
    "./yarn/**/*"
  ],
}