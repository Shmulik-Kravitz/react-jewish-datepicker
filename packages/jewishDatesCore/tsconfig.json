{
  "compilerOptions": {
    "declaration": true,
    "declarationDir": "build",
    "emitDeclarationOnly": true,
    "declarationMap": true,
    "module": "ESNext",
    "target": "ESNext",
    "sourceMap": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "allowJs": true
  },
  "include": [
    "./src/**/*",
    "./app/**/*",
    "./__test__/**/*"
  ],
  "exclude": [
    "./node_modules/**/*",
    "./dist/**/*",
    "./yarn/**/*"
  ],
}